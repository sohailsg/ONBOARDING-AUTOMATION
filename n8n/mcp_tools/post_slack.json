{
  "name": "post_slack",
  "version": "actions_v1",
  "description": "Post a message to a sandbox Slack channel. Returns message ts.",
  "host": "n8n-slack",
  "inputSchema": {
    "type": "object",
    "properties": {
      "channel": {
        "type": "string"
      },
      "text": {
        "type": "string"
      }
    },
    "required": [
      "channel",
      "text"
    ],
    "additionalProperties": false
  },
  "idempotency": {
    "key_format": "{plan_id}:{action_index}",
    "header": "Idempotency-Key",
    "echo_in_response": true
  },
  "timeout_seconds": 20,
  "sandbox": {
    "mode": "fake-record-echo",
    "prod_credentials": "absent"
  }
}