# RAG service env — Ollama embeddings + local Chroma + local rerank. No keys.
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1:8b
RERANK_MODEL=sentence-transformers/ms-marco-MiniLM-L-6-v2
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=policies_v1
CHUNK_PARENT_TOKENS=1024
CHUNK_CHILD_TOKENS=256
HYBRID_TOP_K=30
RERANK_TOP_K=5
ANSWER_CONFIDENCE_THRESHOLD=0.55
