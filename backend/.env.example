# Backend gateway env (see ../../.env.example for master list)
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/onboarding
REDIS_URL=redis://localhost:6379/0
RAG_BASE_URL=http://localhost:8001
JWT_DEV_STUB=true
JWT_SECRET_GENERATED=
SERVICE_API_KEY_GENERATED=
API_HOST=0.0.0.0
API_PORT=8000
ARQ_QUEUE=default
# Executor (05-impl; sandbox loopback only until pilot)
MCP_MODE=sandbox
N8N_MCP_URL=http://localhost:5678/mcp
NOTION_MCP_URL=http://localhost:8002/mcp
CALENDAR_MCP_URL=http://localhost:8003/mcp
TOOL_TIMEOUT_SECONDS=20
EXECUTOR_CONCURRENCY=5
