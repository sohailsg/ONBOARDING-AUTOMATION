    {"title": "Queue depth / DLQ", "targets": [{"expr": "onboarding_dlq_depth"}]},
    {"title": "Action success rate", "targets": [{"expr": "onboarding_actions_total"}]},
    {"title": "Chat Faithfulness trend (avg confidence)", "targets": [{"expr": "onboarding_chat_avg_confidence"}]},
    {"title": "LLM cost per hire (USD)", "targets": [{"expr": "langfuse_cost_per_case_usd"}]},
    {"title": "5xx spike", "targets": [{"expr": "sum(rate(onboarding_requests_total{status=~\"5..\"}[5m]))"}]}
  ]
}
