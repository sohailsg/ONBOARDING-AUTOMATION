# CrewAI worker env — Ollama only, no Anthropic key.
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/onboarding
REDIS_URL=redis://localhost:6379/0
RAG_BASE_URL=http://localhost:8001
WORKER_CONCURRENCY=4
MAX_STEPS_PER_RUN=12
MAX_TOKENS_PER_RUN=30000
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
