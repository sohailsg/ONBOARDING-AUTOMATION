# FREE-STACK ONLY — no paid provider keys exist in this project.
# Copy to .env and adjust. Secrets marked GENERATED are created locally
# (e.g. `openssl rand -hex 32`). Nothing here needs purchase.

# --- Ollama (local LLM + embeddings, free) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Local rerank (HuggingFace, free, downloaded on first use)
RERANK_MODEL=sentence-transformers/ms-marco-MiniLM-L-6-v2

# --- Data (local, free) ---
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/onboarding
REDIS_URL=redis://localhost:6379/0
# Chroma persistent dir (local file, replaces Qdrant)
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=policies_v1

# --- Compose (docker-compose.yml; override ports if busy, e.g. POSTGRES_PORT=5433) ---
POSTGRES_DB=onboarding
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_PORT=5432
REDIS_PORT=6379
N8N_HOST=localhost
N8N_PORT=5678
# Dedicated n8n database (created by db/init/01-n8n-db.sql on fresh volumes)
N8N_DB=n8n

# --- Auth (free) ---
# MVP uses local JWT stub (no SSO provider needed).
JWT_DEV_STUB=true
JWT_SECRET_GENERATED=
# Service key for n8n -> API trigger (generate locally)
SERVICE_API_KEY_GENERATED=
# HMAC for HRIS -> n8n webhook (generate locally)
WEBHOOK_HMAC_SECRET_GENERATED=

# --- Wiring (local defaults) ---
API_BASE_URL=http://localhost:8000
RAG_BASE_URL=http://localhost:8001
N8N_BASE_URL=http://localhost:5678
MCP_MODE=sandbox
# --- Executor + n8n tools (05-impl; sandbox loopback only until pilot) ---
N8N_MCP_URL=http://localhost:5678/mcp
NOTION_MCP_URL=http://localhost:8002/mcp
CALENDAR_MCP_URL=http://localhost:8003/mcp
TOOL_TIMEOUT_SECONDS=20
EXECUTOR_CONCURRENCY=5
HR_DLQ_MAILBOX=hr-dlq@example.com

# --- Optional later (all have free tiers/self-host; leave empty for W0-W5) ---
SENTRY_DSN=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
